# ============================================================
# FitTrainer PRO — variables de entorno
# Copiá este archivo como .env y completá los valores.
# Guía completa: SUPABASE_AUTH.md
# ============================================================

# --- Supabase ---
# Sin estas dos variables la app funciona 100% local (localStorage) y los
# alumnos NO pueden entrar desde su celular.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Dominio interno para el login de los alumnos.
# Ellos entran con un usuario ("nicolas.fit"), pero Supabase Auth necesita un
# email: se arma como usuario@este-dominio. No hace falta que exista de verdad.
# ⚠️ No lo cambies después de haber creado alumnos: dejarían de poder entrar.
VITE_STUDENT_EMAIL_DOMAIN=alumnos.fittrainer.app

# --- Contacto ---
# Número para el banner de cotización, formato internacional sin + ni espacios.
# Si queda vacío, el banner no aparece.
VITE_CONTACT_WHATSAPP=

# --- Mantenimiento ---
# Poné "true" para mostrar el cartel de mantenimiento a todos los usuarios.
# Dejalo vacío o en "false" para operación normal.
# En Vercel: Settings -> Environment Variables, y después Redeploy.
VITE_MAINTENANCE_MODE=false
